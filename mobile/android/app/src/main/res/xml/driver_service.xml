<?xml version="1.0" encoding="utf-8"?>
<!-- The driver's accessibility service reads windows, acts by gesture and
     takes screenshots (Android 11+). Unimportant views remain available so
     the screenshot checks and safety gates can inspect them too. Clicks,
     long clicks and text changes from the owner pause a job. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeWindowsChanged|typeViewScrolled|typeViewClicked|typeViewLongClicked|typeViewTextChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows|flagIncludeNotImportantViews"
    android:canRetrieveWindowContent="true"
    android:canPerformGestures="true"
    android:canTakeScreenshot="true"
    android:notificationTimeout="50"
    android:description="@string/driver_description" />
